# Supabase — Frankfurt (eu-central-1) project, non-negotiable for GDPR
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — DPA signed before processing real client data
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Maps (Geocoding + Directions + JS API)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Email — Register.it (N2O's own account)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# SMS — Skebby (Italian sender ID)
SKEBBY_USERNAME=
SKEBBY_PASSWORD=
SKEBBY_SENDER=N2O

# Transactional (system → admin)
RESEND_API_KEY=
RESEND_FROM=N2O Dashboard <noreply@n2osrl.it>

# App
APP_URL=http://localhost:3000
TZ=Europe/Rome
